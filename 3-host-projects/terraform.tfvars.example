# ==============================================================================
# EXAMPLE terraform.tfvars for 3-host-projects
# ==============================================================================
# Copy to terraform.tfvars and replace placeholders with real values.
# terraform.tfvars is gitignored - never commit real values.
# ==============================================================================

org_id          = "0000000000"            # Replace with your numeric org ID
billing_account = "XXXXXX-XXXXXX-XXXXXX"  # Replace with your billing account ID
project_prefix  = "foundation"
region          = "us-east1"

# Override default APIs per host project (optional):
# host_project_apis = {
#   hub  = ["compute.googleapis.com", "dns.googleapis.com", "servicenetworking.googleapis.com"]
#   dev = ["compute.googleapis.com", "dns.googleapis.com", "container.googleapis.com"]
# }
